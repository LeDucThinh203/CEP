@if (IsEdit && EditModel != null)
{
    <EditForm Model="@EditModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField Value="@CustomerCode"
                              Label="Mã khách hàng"
                              ReadOnly="true"
                              HelperText="Mã khách hàng không được phép chỉnh sửa"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EditModel.FullName"
                              For="@(() => EditModel.FullName)"
                              Label="Họ và tên"
                              Required="true"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EditModel.Email"
                              For="@(() => EditModel.Email)"
                              Label="Email"
                              Required="true"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EditModel.PhoneNumber"
                              For="@(() => EditModel.PhoneNumber)"
                              Label="Số điện thoại"
                              Required="true"
                              MaxLength="20"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Phone" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="EditModel.DateOfBirth"
                               For="@(() => EditModel.DateOfBirth)"
                               Label="Ngày sinh"
                               MaxDate="@DateTime.Today"
                               Editable="true"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                               HelperText="Ngày sinh không được vượt quá ngày hiện tại" />
            </MudItem>

            <MudItem xs="12" sm="6" Class="d-flex align-center">
                <MudSwitch @bind-Value="EditModel.IsActive"
                           Color="Color.Success"
                           Label="@(EditModel.IsActive ? "Đang hoạt động (Active)" : "Ngừng hoạt động (Inactive)")" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-3 mt-4">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="HandleCancel"
                           Disabled="@IsSubmitting"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    Quay lại
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsSubmitting"
                           StartIcon="@(IsSubmitting ? null : Icons.Material.Filled.Save)">
                    @if (IsSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Đang lưu...</MudText>
                    }
                    else
                    {
                        <MudText>Lưu thông tin</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}
else if (EffectiveCreateModel != null)
{
