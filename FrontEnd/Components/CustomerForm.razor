        <DataAnnotationsValidator />

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EffectiveCreateModel.CustomerCode"
                              For="@(() => EffectiveCreateModel.CustomerCode)"
                              Label="Mã khách hàng"
                              Required="true"
                              MaxLength="50"
                              HelperText="Nhập mã định danh (Ví dụ: KH001)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Badge" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EffectiveCreateModel.FullName"
                              For="@(() => EffectiveCreateModel.FullName)"
                              Label="Họ và tên"
                              Required="true"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EffectiveCreateModel.Email"
                              For="@(() => EffectiveCreateModel.Email)"
                              Label="Email"
                              Required="true"
                              MaxLength="100"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="EffectiveCreateModel.PhoneNumber"
                              For="@(() => EffectiveCreateModel.PhoneNumber)"
                              Label="Số điện thoại"
                              Required="true"
                              MaxLength="20"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Phone" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="EffectiveCreateModel.DateOfBirth"
                               For="@(() => EffectiveCreateModel.DateOfBirth)"
                               Label="Ngày sinh"
                               MaxDate="@DateTime.Today"
                               Editable="true"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                               HelperText="Ngày sinh không được vượt quá ngày hiện tại" />
            </MudItem>

            <MudItem xs="12" sm="6" Class="d-flex align-center">
                <MudSwitch @bind-Value="EffectiveCreateModel.IsActive"
                           Color="Color.Success"
                           Label="@(EffectiveCreateModel.IsActive ? "Đang hoạt động (Active)" : "Ngừng hoạt động (Inactive)")" />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-3 mt-4">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           OnClick="HandleCancel"
                           Disabled="@IsSubmitting"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    Quay lại
                </MudButton>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsSubmitting"
                           StartIcon="@(IsSubmitting ? null : Icons.Material.Filled.Save)">
                    @if (IsSubmitting)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Đang lưu...</MudText>
                    }
                    else
                    {
                        <MudText>Lưu thông tin</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}

@code {
    [Parameter]
    public CreateCustomerDto? CreateModel { get; set; }

    [Parameter]
    public CreateCustomerDto? Model { get; set; }

    [Parameter]
    public UpdateCustomerDto? EditModel { get; set; }

    [Parameter]
    public string CustomerCode { get; set; } = string.Empty;

    [Parameter]
    public bool IsEdit { get; set; } = false;

    [Parameter]
    public bool IsSubmitting { get; set; } = false;

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private CreateCustomerDto? EffectiveCreateModel => CreateModel ?? Model;

    private async Task HandleValidSubmit()
    {
        if (OnValidSubmit.HasDelegate)
        {
            await OnValidSubmit.InvokeAsync();
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}
