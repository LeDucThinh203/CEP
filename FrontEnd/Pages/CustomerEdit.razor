@page "/customers/edit/{id:int}"
@attribute [Authorize]
@inject CustomerApiService CustomerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Chỉnh sửa khách hàng - CEP System</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mb-4" />

    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Class="mr-2" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">Cập nhật thông tin khách hàng</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Chỉnh sửa thông tin chi tiết (Mã khách hàng là cố định)</MudText>
                    </div>
                </div>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (_isLoading)
            {
                <LoadingComponent IsLoading="true" Text="Đang tải thông tin khách hàng..." />
            }
            else if (_notFound)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Không tìm thấy thông tin khách hàng hoặc khách hàng không còn tồn tại.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/customers">
                    Quay lại danh sách
                </MudButton>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
                        @_errorMessage
                    </MudAlert>
                }

                <CustomerForm Model="@_customerModel"
                              IsEdit="true"
                              IsSubmitting="@_isSubmitting"
                              OnValidSubmit="HandleEditSubmit"
                              OnCancel="NavigateBack" />
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private CreateCustomerDto _customerModel = new();
    private bool _isLoading = true;
    private bool _notFound = false;
    private bool _isSubmitting = false;
    private string? _errorMessage;

    private readonly List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Khách hàng", href: "/customers"),
        new BreadcrumbItem("Chỉnh sửa", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerDataAsync();
    }

    private async Task LoadCustomerDataAsync()
    {
        _isLoading = true;
        var response = await CustomerService.GetCustomerByIdAsync(Id);
        _isLoading = false;

        if (response != null && response.Success && response.Data != null)
        {
            var data = response.Data;
            _customerModel = new CreateCustomerDto
            {
                CustomerCode = data.CustomerCode,
                FullName = data.FullName,
                Email = data.Email,
                PhoneNumber = data.PhoneNumber,
                DateOfBirth = data.DateOfBirth,
                IsActive = data.IsActive
            };
            _notFound = false;
        }
        else
        {
            _notFound = true;
            Snackbar.Add(response?.Message ?? "Không thể tìm thấy khách hàng.", Severity.Warning);
        }
    }

    private async Task HandleEditSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var updateDto = new UpdateCustomerDto
        {
            FullName = _customerModel.FullName,
            Email = _customerModel.Email,
            PhoneNumber = _customerModel.PhoneNumber,
            DateOfBirth = _customerModel.DateOfBirth,
            IsActive = _customerModel.IsActive
        };

        var (success, message) = await CustomerService.UpdateCustomerAsync(Id, updateDto);
        _isSubmitting = false;

        if (success)
        {
            Snackbar.Add("Cập nhật khách hàng thành công.", Severity.Success);
            Navigation.NavigateTo("/customers");
        }
        else
        {
            _errorMessage = message;
            Snackbar.Add(message, Severity.Error);
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/customers");
    }
}
