@inject AuthService AuthService
@inject NavigationManager Navigation

<MudNavMenu Class="mud-width-full">
    <MudNavLink Href="/customers" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People">
        Quản lý khách hàng
    </MudNavLink>
    <MudNavLink Href="/customers/create" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">
        Thêm khách hàng
    </MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink OnClick="HandleLogout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
        Đăng xuất
    </MudNavLink>
</MudNavMenu>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
